# Copy to .env (never commit the real one).
ANTHROPIC_API_KEY=
# claude | fake (offline demo notes, no key needed)
AMN_EXTRACTOR=claude
AMN_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AMN_CLAUDE_EFFORT=medium
# whisper | fake (skips audio decoding, returns a demo transcript)
AMN_TRANSCRIBER=whisper
# tiny, base, small, medium, large-v3, or an English-only variant like base.en
AMN_WHISPER_MODEL=base
AMN_WHISPER_DEVICE=auto
AMN_WHISPER_COMPUTE_TYPE=int8
AMN_MAX_UPLOAD_MB=200
AMN_WORKER_CONCURRENCY=2
